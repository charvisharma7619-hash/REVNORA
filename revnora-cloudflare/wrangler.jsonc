{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revnora-backend",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revnora-db",
